<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16171B">

    <!-- ═════════ المتصفح ═════════ -->
    <LinearLayout
        android:id="@+id/browser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#1E2026"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/tabsScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingTop="6dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/newTab"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="＋"
                android:textColor="#E8EAF0"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#282B35"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="◀"
                android:textColor="#E8EAF0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnForward"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="#E8EAF0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnReload"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⟳"
                android:textColor="#E8EAF0"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_address"
                android:hint="ابحث أو اكتب عنوان موقع"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="#E8EAF0"
                android:textColorHint="#9097A8"
                android:textDirection="ltr"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnStar"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="☆"
                android:textColor="#E8EAF0"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/btnAi"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✦"
                android:textColor="#6AA8FF"
                android:textSize="19sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="#6AA8FF"
            android:visibility="invisible" />

        <HorizontalScrollView
            android:id="@+id/bookmarksScroll"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#1E2026"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/bookmarks"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/webHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ═════════ المساعد (يغطي الشاشة) ═════════ -->
    <LinearLayout
        android:id="@+id/aiPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E2026"
        android:clickable="true"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#282B35"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المساعد"
                android:textColor="#E8EAF0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modelLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:layoutDirection="ltr"
                android:maxLines="1"
                android:textColor="#9097A8"
                android:textDirection="ltr"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🗑"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#E8EAF0"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnCloseAi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#E8EAF0"
                android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- المحادثة -->
            <LinearLayout
                android:id="@+id/chatPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/chatScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/messages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/emptyHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.3"
                            android:paddingTop="40dp"
                            android:text="اسأل عن الصفحة المفتوحة، أو اطلب تلخيصاً أو ترجمة.\nالنموذج يعمل عندك، ولا يُرسل شيء إلى خدمات خارجية."
                            android:textColor="#9097A8"
                            android:textSize="14sp" />
                    </LinearLayout>
                </ScrollView>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="8dp" />
                </HorizontalScrollView>

                <CheckBox
                    android:id="@+id/usePage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:checked="true"
                    android:text="استخدام محتوى الصفحة الحالية كسياق"
                    android:textColor="#9097A8"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <EditText
                        android:id="@+id/prompt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="اكتب سؤالك…"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:minHeight="44dp"
                        android:padding="10dp"
                        android:textColor="#E8EAF0"
                        android:textColorHint="#9097A8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnSend"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_send"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="68dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="إرسال"
                        android:textColor="#0B1020"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- الإعدادات -->
            <ScrollView
                android:id="@+id/settingsPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@android:style/TextAppearance.Material.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عنوان الخادم"
                        android:textColor="#9097A8" />

                    <EditText
                        android:id="@+id/setEndpoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:inputType="textUri"
                        android:layoutDirection="ltr"
                        android:padding="10dp"
                        android:textColor="#E8EAF0"
                        android:textDirection="ltr"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="على الهاتف، localhost تعني الهاتف نفسه. إن كان النموذج على حاسوبك فاكتب عنوانه في الشبكة، مثل http://192.168.1.10:11434، وشغّل Ollama بالأمر: OLLAMA_HOST=0.0.0.0 ollama serve"
                        android:textColor="#9097A8"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="مفتاح (اختياري)"
                        android:textColor="#9097A8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/setKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:inputType="textPassword"
                        android:layoutDirection="ltr"
                        android:padding="10dp"
                        android:textColor="#E8EAF0"
                        android:textDirection="ltr"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="النموذج"
                        android:textColor="#9097A8"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/setModel"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layoutDirection="ltr" />

                        <TextView
                            android:id="@+id/btnRefreshModels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="تحديث"
                            android:textColor="#E8EAF0"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/modelsMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#9097A8"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/setNoThink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="تعطيل التفكير الطويل (لنماذج Qwen3 فقط)"
                        android:textColor="#E8EAF0"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="أقصى طول لنص الصفحة (حرف)"
                        android:textColor="#9097A8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/setMax"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:inputType="number"
                        android:layoutDirection="ltr"
                        android:padding="10dp"
                        android:textColor="#E8EAF0"
                        android:textDirection="ltr"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="محرك البحث (استخدم %s مكان الكلمات)"
                        android:textColor="#9097A8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/setSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:inputType="textUri"
                        android:layoutDirection="ltr"
                        android:padding="10dp"
                        android:textColor="#E8EAF0"
                        android:textDirection="ltr"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="تعليمات النظام"
                        android:textColor="#9097A8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/setSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="4"
                        android:padding="10dp"
                        android:textColor="#E8EAF0"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSave"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_send"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="90dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="حفظ"
                            android:textColor="#0B1020"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSettingsBack"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="رجوع"
                            android:textColor="#E8EAF0"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/savedMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#9097A8"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
